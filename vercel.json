{
  "buildCommand": "sh scripts/sns-config.sh",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/", "destination": "/show", "permanent": false }
  ],
  "rewrites": [
    { "source": "/show", "destination": "/sns-show.html" },
    { "source": "/console", "destination": "/sns-console.html" }
  ]
}
